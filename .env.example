# No secrets needed for local previews. Set environment variables before launch.
# This file is documentation; the application does not load .env automatically.
# Never commit OAuth client secrets or refresh tokens.
# Optional FFmpeg override (otherwise bundled imageio-ffmpeg executable):
IMAGEIO_FFMPEG_EXE=
# Optional licensed TrueType font; default uses Pillow's bundled font.
TSF_FONT=

# Local dashboard database (environment variable; .env is not loaded automatically):
# TSF_DB_PATH=local-data/control-room.sqlite3

# Disable online CC0 lookup for offline runs and bounded tests:
# TSF_COMMONS=0
# Local story and vision checks use Ollama at 127.0.0.1:11434.
# No paid provider is enabled. YouTube OAuth files stay under the database directory.

# Normal topic production uses the authenticated remote worker connection in Factory services.
# Worker credentials are stored in ignored, mode-0600 remote-worker.json beside the database.
# TSF_WORKER_PROCESS=1 belongs ONLY in the remote container, not on the desktop.
# TSF_LOCAL_FIXTURE_MODE=1 is solely for bounded local development fixtures; never a production fallback.
